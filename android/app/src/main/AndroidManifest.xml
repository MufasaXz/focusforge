<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Notifications. Android 13+ makes this a runtime permission, so it has
         to be declared here or `Permission.notification.request()` returns
         "permanently denied" without ever showing a dialog. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- No SYSTEM_ALERT_WINDOW: the Deep Breath Gate is drawn as a
         TYPE_ACCESSIBILITY_OVERLAY window by the accessibility service, which
         the service may do without the draw-over-apps permission. Asking for
         it would be a permission the app never exercises. -->

    <!-- Usage access, for the per-app screen-time breakdown. A special
         permission: the user grants it from Settings rather than from a
         dialog. The tools:ignore is required because lint treats every
         PACKAGE_USAGE_STATS declaration as a Play Store policy risk. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>

    <!-- Do Not Disturb access, for Strict Mode. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>

    <!-- Merged in from the Google libraries, and removed again. READ_GSERVICES
         is a signature permission: only apps signed by Google are ever granted
         it, so for this app it does nothing at runtime — but it is printed in
         the permission list every installer and security scanner reads, and a
         focus app asking to read Google services data is a question with no
         good answer. Google sign-in talks to Play services through its own
         APIs, not through this provider. -->
    <uses-permission
        android:name="com.google.android.providers.gsf.permission.READ_GSERVICES"
        tools:node="remove"/>

    <application
        android:label="FocusForge"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- The accessibility service the shield runs on. Android has no
             dialog for accessibility access — the user enables it from
             Settings — so this declaration is what makes FocusForge appear in
             that list at all. See res/xml/accessibilityservice.xml for what it
             is allowed to observe.

             `isAccessibilityTool="false"` is the honest answer and Android 12+
             reads it: this service is not a tool for people with disabilities,
             it is a focus tool that watches which app came to the front. Play
             asks for the attribute to be stated rather than inferred, and a
             false here is what makes the system's own warning about the
             service accurate. -->
        <service
            android:name=".shield.FocusAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="FocusForge">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibilityservice"/>
        </service>

        <receiver android:name=".widgets.FocusWidget" android:exported="false" android:label="FocusForge — Retro clock">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ff_focus_widget_info" />
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Package visibility, without QUERY_ALL_PACKAGES.

             Android 11+ hides installed apps from the package manager unless
             the app says which ones it needs. The shield's list wants exactly
             one class of app: the ones with a launcher icon, because those are
             the ones a user can open and therefore the only ones a block can
             fire on. Declaring that intent is what grants visibility to them
             and to nothing else.

             `QUERY_ALL_PACKAGES` would also work and is what this used to
             declare — but Google Play restricts it to a short list of approved
             use cases, and "an app blocker" is not on it, so the permission is
             a rejection waiting to happen. This does the same job and needs no
             declaration form. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>

        <!-- And the launcher itself, which is a HOME activity and not
             necessarily a LAUNCHER one. The engine resolves it to put it on
             the never-close list; without this entry the lookup comes back
             null, the home app is not protected, and a rule that matched it
             would leave the phone with no way back to the app list. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
    </queries>
</manifest>
