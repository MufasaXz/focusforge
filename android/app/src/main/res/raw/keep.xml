<?xml version="1.0" encoding="utf-8"?>
<!--
  Keeps resources the shrinker cannot see a reference to.

  `default_web_client_id` is generated by the google-services plugin from
  google-services.json, and the google_sign_in Android plugin reads it by
  name at runtime:

      resources.getIdentifier("default_web_client_id", "string", packageName)

  A lookup by name is invisible to static analysis, so with
  `isShrinkResources = true` the shrinker reports the string as unreachable
  and strips it from the release bundle. Debug builds are unshrunk, which is
  why Google sign-in works locally and fails only on a Play build: without
  the web client id the plugin cannot request an ID token, so Firebase gets
  no credential and the sign-in reports a configuration failure.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
