<?xml version="1.0" encoding="utf-8"?>
<!--
  The screen shown over a blocked app.

  Drawn by the app-boundary service or the accessibility service as an overlay
  window, so it is not part of the Flutter tree and cannot read the app's
  ColorScheme. The colours are the same roles, defined in values/ and
  values-night/ so the two brightnesses stay in step with the rest of the app.

  A pause, not an error page: the blocked app's own icon, in no tile or badge
  of ours, rests in the middle with a slow breath behind it (animated by BlockOverlayRoot, still when the system
  turns animation off), the message under it, and the two actions in thumb
  reach at the bottom. The filled action gets the user out of the app; the
  tonal one leads to the breathing pause before any way back in. There is no
  outside-touch-to-dismiss and no timer: a block screen with an escape hatch
  that is easier than the decision is not a block screen.

  Both services look these views up by id, so the ids and view types are part
  of the contract with AppBlockingService and FocusAccessibilityService.
-->
<dev.focusforge.focusforge.shield.BlockOverlayRoot xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ff_block_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ff_block_surface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ff_block_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ff_block_gutter"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ff_launch_mark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="FocusForge"
                    android:textColor="@color/ff_block_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="216dp"
                android:layout_height="216dp"
                android:layout_marginTop="16dp">

                <View
                    android:id="@+id/ff_block_halo_outer"
                    android:layout_width="216dp"
                    android:layout_height="216dp"
                    android:layout_gravity="center"
                    android:alpha="0.10"
                    android:background="@drawable/ff_block_halo" />

                <View
                    android:id="@+id/ff_block_halo_inner"
                    android:layout_width="164dp"
                    android:layout_height="164dp"
                    android:layout_gravity="center"
                    android:alpha="0.18"
                    android:background="@drawable/ff_block_halo" />

                <ImageView
                    android:id="@+id/ff_block_icon"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/ff_block_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="320dp"
                android:textColor="@color/ff_block_muted"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.08"
                android:maxWidth="340dp"
                android:text="@string/ff_copy_52ae6350b671"
                android:textColor="@color/ff_block_on_surface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ff_block_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:maxWidth="320dp"
                android:textColor="@color/ff_block_muted"
                android:textSize="16sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/ff_block_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/ff_block_button_primary"
                android:minHeight="56dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp"
                android:stateListAnimator="@null"
                android:text="@string/ff_block_back"
                android:textAllCaps="false"
                android:textColor="@color/ff_block_on_accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ff_block_anyway"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/ff_block_button_tonal"
                android:minHeight="52dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="13dp"
                android:stateListAnimator="@null"
                android:text="@string/ff_block_anyway"
                android:textAllCaps="false"
                android:textColor="@color/ff_block_on_tonal"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/ff_block_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:maxWidth="300dp"
                android:textColor="@color/ff_block_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</dev.focusforge.focusforge.shield.BlockOverlayRoot>
