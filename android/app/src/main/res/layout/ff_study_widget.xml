<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/ff_widget_day">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FOCUSFORGE" android:textSize="10sp" android:letterSpacing="0.12" android:textStyle="bold" />
<TextView android:id="@+id/widget_subject" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a subject" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="8dp" />
<TextView android:id="@+id/widget_time" style="@style/FocusWidgetNumerals" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="25:00" android:textSize="34sp" />
<Chronometer android:id="@+id/widget_live" style="@style/FocusWidgetNumerals" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="34sp" android:visibility="gone" />
<TextView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 min today" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp" />
<TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap to focus" android:textSize="10sp" android:maxLines="2" android:layout_marginTop="3dp" />
</LinearLayout>
