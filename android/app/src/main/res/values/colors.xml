<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the splash. This is the theme's own `surface` role,
         so the hand-off from the Android window to the Flutter splash has no
         visible seam. values-night/ carries the dark one. -->
    <color name="ff_launch_background">#FFF8F6</color>

    <!-- The block screen. It is drawn by the accessibility service rather than
         by Flutter, so it cannot read the app's ColorScheme — these are the
         same roles, kept here by hand. values-night/ carries the dark set. -->
    <color name="ff_block_surface">#FFF8F6</color>
    <color name="ff_block_on_surface">#201A18</color>
    <color name="ff_block_muted">#54433C</color>
    <color name="ff_block_outline">#D8C2BA</color>
    <color name="ff_block_accent">#9A461C</color>
    <color name="ff_block_on_accent">#FFFFFF</color>
    <color name="ff_block_container">#F5E5DE</color>
</resources>
