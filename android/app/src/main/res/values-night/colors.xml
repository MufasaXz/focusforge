    <color name="ff_block_on_surface">#EDE0DB</color>
    <color name="ff_block_muted">#D8C2BA</color>
    <color name="ff_block_outline">#54433C</color>
    <color name="ff_block_accent">#FFB692</color>
    <color name="ff_block_on_accent">#542100</color>
    <color name="ff_block_container">#332822</color>
</resources>
