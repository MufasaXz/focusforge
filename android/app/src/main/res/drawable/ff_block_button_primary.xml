<?xml version="1.0" encoding="utf-8"?>
<!-- The filled action on the block screen. A ripple over a solid ember pill,
     sized to match the app's own FilledButton. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ff_block_accent" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</ripple>
