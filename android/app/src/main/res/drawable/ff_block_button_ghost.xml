<?xml version="1.0" encoding="utf-8"?>
<!-- The quiet action on the block screen. Outlined rather than filled, so the
     way out of the block is the loud one. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#22E8672A">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/ff_block_outline" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</ripple>
