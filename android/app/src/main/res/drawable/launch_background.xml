<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen: the app's own surface colour with the mark centred on
     it, so the Android window and the Flutter splash read as one screen. The
     colour comes from values/ (light) or values-night/ (dark). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ff_launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ff_launch_mark" />
    </item>
</layer-list>
