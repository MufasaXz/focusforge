// Pip's AI proxy on Cloudflare Workers (free plan).
// Secrets are set with `wrangler secret put`, never written here:
//   GEMINI_API_KEY  Google AI Studio key (primary model)
//   GROQ_API_KEY    Groq key (fallback model)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pip-ai-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "focusforge-1edf7",
    "GEMINI_MODEL": "gemini-flash-lite-latest",
    "GROQ_MODEL": "openai/gpt-oss-20b"
  },
  // Reports of answers, kept 90 days for review (Google Play's rule for
  // generated content). List them with `wrangler kv key list --binding REPORTS`.
  "kv_namespaces": [
    { "binding": "REPORTS", "id": "753636be5a7c4186a17e643bec18bd13" }
  ],
  // Short-term burst limits per Cloudflare location. The website separately
  // enforces an atomic daily allowance across locations and checks revocation.
  "ratelimits": [
    { "name": "PER_USER_LIMIT", "namespace_id": "4101", "simple": { "limit": 6, "period": 60 } },
    { "name": "ALL_USERS_LIMIT", "namespace_id": "4102", "simple": { "limit": 300, "period": 60 } },
    // Per address, before the token is checked: one network can hold many
    // accounts, so it sits well above the per-account limit.
    { "name": "CALLER_LIMIT", "namespace_id": "4103", "simple": { "limit": 60, "period": 60 } }
  ]
}
