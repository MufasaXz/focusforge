rules_version = '2';

// FocusForge parent control.
//
// The shape of the data is what these rules protect:
//
//   pairCodes/{code}                 a six-digit code a child's app shows
//   users/{uid}                      role, name, the linked parent's name
//   users/{uid}/children/{childUid}  a parent's list of children
//   users/{uid}/guardian/link        a child's record of the parent who linked,
//                                    and the digest of the code they set
//   users/{uid}/progress/{doc}       the child's own study summary
//   users/{uid}/remoteRules/{doc}    the block list a parent set for that child
//   users/{uid}/catalog/{doc}        the apps on the child's device
//   leaderboard/{week}/entries/{uid} one row per person per week
//
// Two rules do the real work: a document under a user's tree is readable by
// that user and by their linked guardian, and writable by exactly one of them
// — the child owns their progress, the parent owns the rules they set. Nothing
// here lets one account read another account's tree, and a pairing code is
// only ever claimable by the child who minted it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // True when the caller is the parent the child's own record names. The
    // lookup is one document read, and it is the only way in to a child's
    // tree from outside it.
    function isGuardianOf(uid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(uid)/guardian/link) &&
        get(/databases/$(database)/documents/users/$(uid)/guardian/link).data.parentUid == request.auth.uid;
    }

    // A pairing code is readable by any signed-in account — that is what
    // claiming one means — but only its owner can write or retire it.
    match /pairCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.childUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.childUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isGuardianOf(uid);
      allow write: if isSelf(uid);

      // The parent's own list. Nobody else reads it: a child has no reason to
      // enumerate their parent's other children.
      match /children/{childUid} {
        allow read, write: if isSelf(uid);
      }

      // Written once, by the parent, when they claim the child's code. The
      // child reads it back to show the connection on their own side, and may
      // retire it; the create is refused while a record already exists, so a
      // second parent cannot take over a device that is already linked.
      //
      // The record also carries the four-digit code a parent sets for this
      // device — a salted digest, never the digits. The parent writes it here
      // (an update), because it is the record the code protects: the child's
      // device reads the same document to check what was typed. A parent may
      // update the record but not re-parent it — `parentUid` has to stay as it
      // was — and a child may not edit the digest that stands between them and
      // an unlink, which is why the self case is delete-only.
      //
      // `match` statements point at *documents*, and `users/{uid}/guardian`
      // has an odd number of segments — it names a collection, not a document,
      // so a rule block written there does not cover the `guardian/link`
      // document the app reads and writes. The read goes through
      // `isGuardianOf()`, which tests `exists()` before it touches `get()`:
      // reaching into `resource.data` on a device that has never been linked is
      // an *error*, not a false, and an error anywhere in a rule denies the
      // request — so the `isSelf` that should have allowed a child to read
      // their own missing record would never get a chance to.
      match /guardian/{doc} {
        allow read: if isSelf(uid) || isGuardianOf(uid);
        allow create: if signedIn() &&
          request.resource.data.parentUid == request.auth.uid &&
          !exists(/databases/$(database)/documents/users/$(uid)/guardian/link);
        allow update: if isGuardianOf(uid) &&
          request.resource.data.parentUid == resource.data.parentUid;
        allow delete: if isSelf(uid);
      }

      // The child's progress: the child writes it, the guardian reads it.
      match /progress/{doc} {
        allow read: if isSelf(uid) || isGuardianOf(uid);
        allow write: if isSelf(uid);
      }

      // The rules a parent set for this child: the guardian writes them, the
      // child's app reads and applies them. The child cannot write them, which
      // is the point.
      match /remoteRules/{doc} {
        allow read: if isSelf(uid) || isGuardianOf(uid);
        allow write: if isGuardianOf(uid);
      }

      // The apps installed on this device. The child publishes them so their
      // parent has something to choose from; only the guardian may read them,
      // and only the child may write them.
      match /catalog/{doc} {
        allow read: if isSelf(uid) || isGuardianOf(uid);
        allow write: if isSelf(uid);
      }
    }

    // The weekly board. A row is a name and an hour count — nothing else —
    // and it is readable by anyone signed in, because being on a board is a
    // public act. Writing is not: a row is only ever yours.
    match /leaderboard/{week}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['name', 'minutes', 'updatedAt']) &&
        request.resource.data.minutes is int &&
        request.resource.data.minutes >= 0 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 60;
      allow delete: if isSelf(uid);
    }
  }
}
