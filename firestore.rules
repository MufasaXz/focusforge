rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null &&
        (request.auth.token.firebase.sign_in_provider != 'password' ||
          request.auth.token.get('email_verified', false) == true) &&
        !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }
    function account() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function cleanupAccount() {
      return request.auth != null &&
        (request.auth.token.firebase.sign_in_provider != 'anonymous' || deleting(request.auth.uid));
    }
    function deleting(uid) {
      return owner(uid) && exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }
    function boundedInt(value, maximum) { return value is int && value >= 0 && value <= maximum; }
    function dayKey(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function localTimestamp(value) {
      return value is int && value >= 0 && value <= request.time.toMillis() + 60000;
    }
    // Badges are a private, small union of earned IDs and original dates.
    // Zero preserves older unlocks whose original date was never recorded.
    function badgeDate(dates, before, id, latest) {
      let date = dates.get(id, 0);
      let oldDate = before.get(id, 0);
      return date is int && date >= 0 && date <= latest &&
        (oldDate == 0 || (date > 0 && date <= oldDate));
    }
    function achievementShape(d, before) {
      let dates = d.unlockedAt;
      let latest = request.time.toMillis() + 60000;
      return d.keys().hasOnly(['version','unlockedAt']) && d.version == 1 &&
        dates is map && dates.keys().hasOnly([
          'first_focus','week_warrior','century_club','night_owl',
          'early_bird','deep_diver','steady_hand','month_king',
          'hundred_hours','marathon','perfectionist','subject_master',
          'night_shift','breath_master',
          'five_sessions','three_day_streak','five_hours','ten_hours'
        ]) && dates.keys().hasAll(before.keys()) &&
        // Validate type, bounds and earliest-date retention in one pass.
        // Separate passes exceed Firestore's expression limit with 18 IDs.
        badgeDate(dates, before, 'first_focus', latest) && badgeDate(dates, before, 'week_warrior', latest) &&
        badgeDate(dates, before, 'century_club', latest) && badgeDate(dates, before, 'night_owl', latest) &&
        badgeDate(dates, before, 'early_bird', latest) && badgeDate(dates, before, 'deep_diver', latest) &&
        badgeDate(dates, before, 'steady_hand', latest) && badgeDate(dates, before, 'month_king', latest) &&
        badgeDate(dates, before, 'hundred_hours', latest) && badgeDate(dates, before, 'marathon', latest) &&
        badgeDate(dates, before, 'perfectionist', latest) && badgeDate(dates, before, 'subject_master', latest) &&
        badgeDate(dates, before, 'night_shift', latest) && badgeDate(dates, before, 'breath_master', latest) &&
        badgeDate(dates, before, 'five_sessions', latest) && badgeDate(dates, before, 'three_day_streak', latest) &&
        badgeDate(dates, before, 'five_hours', latest) && badgeDate(dates, before, 'ten_hours', latest);
    }
    // Retired monitoring cannot be recreated. Private owner reads/deletes
    // below permit account cleanup without reintroducing sharing.
    match /pairCodes/{code} { allow read, write: if false; }
    match /accountCleanup/{doc} {
      allow get: if request.auth != null && doc == 'schema';
      allow list, write: if false;
    }
    match /accountDeletions/{uid} {
      allow get: if owner(uid);
      allow list, update, delete: if false;
      // Immutable security fence. No profile, password or email is retained.
      allow create: if owner(uid) &&
        request.resource.data.keys().hasOnly(['requestedAt']) &&
        request.resource.data.requestedAt == request.time &&
        (request.auth.token.firebase.sign_in_provider == 'anonymous' ||
          (request.auth.token.auth_time is int &&
           request.auth.token.auth_time >= request.time.toMillis() / 1000 - 300 &&
           request.auth.token.auth_time <= request.time.toMillis() / 1000 + 60));
    }
    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if self(uid);
      match /achievements/{doc} {
        allow read: if owner(uid) && (cleanupAccount() || deleting(uid));
        allow create: if account() && self(uid) && doc == 'earned' &&
          achievementShape(request.resource.data, {});
        allow update: if account() && self(uid) && doc == 'earned' &&
          achievementShape(request.resource.data, resource.data.unlockedAt);
        allow delete: if owner(uid);
      }
      match /achievements/{record=**} {
        allow read: if owner(uid) && (cleanupAccount() || deleting(uid));
        allow delete: if owner(uid);
      }
      // Private returning-account backup. App usage and Shield records are
      // excluded; only study setup and completed focus sessions are stored.
      match /preferences/studyBackup {
        allow create, update: if account() && self(uid) &&
          request.resource.data.keys().hasOnly(['version','ownerUid','data','modifiedAt']) &&
          request.resource.data.version == 1 && request.resource.data.ownerUid == uid &&
          request.resource.data.data is string && request.resource.data.data.size() <= 300000 &&
          localTimestamp(request.resource.data.modifiedAt);
      }
      match /sessionData/{session} {
        allow create, update: if account() && self(uid) &&
          request.resource.data.keys().hasOnly(['id','subjectId','startedAt','minutes','completed','label','ownerUid']) &&
          request.resource.data.ownerUid == uid &&
          request.resource.data.id is string && request.resource.data.id.size() > 0 && request.resource.data.id.size() <= 200 &&
          request.resource.data.subjectId is string && request.resource.data.subjectId.size() <= 200 &&
          request.resource.data.label is string && request.resource.data.label.size() <= 200 &&
          localTimestamp(request.resource.data.startedAt) &&
          boundedInt(request.resource.data.minutes, 1440) &&
          request.resource.data.completed is bool;
      }
      match /{privateCollection}/{record=**} {
        allow read, delete: if owner(uid) && privateCollection != 'achievements';
        allow create, update: if false;
      }
    }
    match /leaderboard/{week}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if self(uid) && dayKey(week) &&
        request.resource.data.keys().hasOnly(['ownerUid','name','minutes','level','updatedAt']) &&
        request.resource.data.ownerUid == uid &&
        boundedInt(request.resource.data.minutes, 10080) &&
        (!request.resource.data.keys().hasAny(['level']) ||
          (request.resource.data.level is int && request.resource.data.level >= 1)) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 && localTimestamp(request.resource.data.updatedAt);
      allow delete: if owner(uid);
    }

    match /{path=**}/entries/{entry} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Invites can be looked up by exact code, never enumerated. Only members
    // can read group metadata or progress. Session logs are never uploaded.
    function member(group) {
      return cleanupAccount() && request.auth.uid in
        get(/databases/$(database)/documents/studyGroups/$(group)).data.memberIds;
    }
    function groupShape(data) {
      return data.keys().hasOnly(['name','targetHours','createdAt','ownerUid','memberIds','inviteCode']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 60 &&
        data.targetHours is int && data.targetHours >= 1 && data.targetHours <= 1000 &&
        data.createdAt is int && data.memberIds is list && data.memberIds.size() >= 1 &&
        data.memberIds.size() <= 32 && data.memberIds.toSet().size() == data.memberIds.size() &&
        data.ownerUid in data.memberIds && data.inviteCode is string &&
        data.inviteCode.matches('^[A-Z2-9]{10}$');
    }
    function joining(group) {
      let row = getAfter(/databases/$(database)/documents/studyGroups/$(group)/members/$(request.auth.uid)).data;
      return row.inviteCode == resource.data.inviteCode &&
        get(/databases/$(database)/documents/groupInvites/$(row.inviteCode)).data.groupId == group;
    }
    match /groupInvites/{code} {
      allow get: if account();
      allow list: if false;
      allow create: if account() && request.resource.data.keys().hasOnly(['groupId']) &&
        getAfter(/databases/$(database)/documents/studyGroups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/studyGroups/$(request.resource.data.groupId)).data.inviteCode == code;
      allow update: if false;
      allow delete: if member(resource.data.groupId) &&
        !existsAfter(/databases/$(database)/documents/studyGroups/$(resource.data.groupId));
    }
    match /studyGroups/{group} {
      allow read: if cleanupAccount() && request.auth.uid in resource.data.memberIds;
      allow create: if account() && groupShape(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid] &&
        getAfter(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)).data.groupId == group &&
        existsAfter(/databases/$(database)/documents/studyGroups/$(group)/members/$(request.auth.uid));
      allow update: if cleanupAccount() && groupShape(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','ownerUid']) &&
        ((account() && !(request.auth.uid in resource.data.memberIds) &&
            request.resource.data.ownerUid == resource.data.ownerUid &&
            request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet()) &&
            joining(group)) ||
          (request.auth.uid in resource.data.memberIds &&
            request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]) &&
            (resource.data.ownerUid == request.auth.uid || request.resource.data.ownerUid == resource.data.ownerUid) &&
            !existsAfter(/databases/$(database)/documents/studyGroups/$(group)/members/$(request.auth.uid))));
      allow delete: if cleanupAccount() && resource.data.memberIds == [request.auth.uid] &&
        !existsAfter(/databases/$(database)/documents/groupInvites/$(resource.data.inviteCode)) &&
        !existsAfter(/databases/$(database)/documents/studyGroups/$(group)/members/$(request.auth.uid));
      match /members/{uid} {
        allow read: if member(group);
        function validRow() {
          let d = request.resource.data;
          return d.keys().hasOnly(['ownerUid','name','joinedAt','inviteCode','week','minutes','focusUntil','updatedAt']) &&
            d.ownerUid == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 60 &&
            d.joinedAt is int && d.inviteCode is string && d.week is string &&
            d.week.size() <= 10 && d.minutes is int && d.minutes >= 0 && d.minutes <= 10080 &&
            d.focusUntil is int && d.focusUntil >= 0 && d.focusUntil <= request.time.toMillis() + 86400000 &&
            d.updatedAt == request.time;
        }
        allow create: if account() && self(uid) && validRow() &&
          uid in getAfter(/databases/$(database)/documents/studyGroups/$(group)).data.memberIds &&
          getAfter(/databases/$(database)/documents/studyGroups/$(group)).data.inviteCode == request.resource.data.inviteCode &&
          getAfter(/databases/$(database)/documents/groupInvites/$(request.resource.data.inviteCode)).data.groupId == group;
        allow update: if account() && self(uid) && member(group) && validRow() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','week','minutes','focusUntil','updatedAt']);
        allow delete: if deleting(uid) &&
          (!exists(/databases/$(database)/documents/studyGroups/$(group)) ||
           !(uid in get(/databases/$(database)/documents/studyGroups/$(group)).data.memberIds));
        allow delete: if cleanupAccount() && owner(uid) && member(group) &&
          (!existsAfter(/databases/$(database)/documents/studyGroups/$(group)) ||
            !(uid in getAfter(/databases/$(database)/documents/studyGroups/$(group)).data.memberIds));
      }
    }
  }
}
