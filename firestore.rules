rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function account() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function guardian(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/guardian/link) &&
        get(/databases/$(database)/documents/users/$(uid)/guardian/link).data.parentUid == request.auth.uid;
    }
    function pairValid(code, child) {
      let path = /databases/$(database)/documents/pairCodes/$(code);
      return exists(path) && get(path).data.childUid == child &&
        !('claimedBy' in get(path).data) &&
        get(path).data.expiresAt > request.time.toMillis() &&
        getAfter(path).data.claimedBy == request.auth.uid;
    }
    match /pairCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[0-9]{6}$') &&
        request.resource.data.keys().hasOnly(['childUid','childName','createdAt','expiresAt']) &&
        request.resource.data.childUid == request.auth.uid &&
        request.resource.data.childName is string && request.resource.data.childName.size() <= 60 &&
        request.resource.data.createdAt is int && request.resource.data.expiresAt is int &&
        request.resource.data.expiresAt > request.time.toMillis() &&
        request.resource.data.expiresAt <= request.time.toMillis() + 960000;
      allow update: if signedIn() && !('claimedBy' in resource.data) &&
        resource.data.childUid != request.auth.uid &&
        resource.data.expiresAt > request.time.toMillis() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy']) &&
        request.resource.data.claimedBy == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(resource.data.childUid)/guardian/link).data.parentUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(resource.data.childUid)/guardian/link).data.pairCode == code;
      allow delete: if self(resource.data.childUid);
    }
    match /users/{uid} {
      allow read: if self(uid) || guardian(uid);
      allow write: if self(uid);
      match /children/{child} {
        allow read: if self(uid);
        allow create, update: if self(uid) &&
          getAfter(/databases/$(database)/documents/users/$(child)/guardian/link).data.parentUid == uid &&
          request.resource.data.keys().hasOnly(['name','linkedAt']) &&
          request.resource.data.name is string && request.resource.data.name.size() <= 60 &&
          request.resource.data.linkedAt is int;
        allow delete: if self(uid) || (self(child) && guardianRecordMatches(uid, child) &&
          !existsAfter(/databases/$(database)/documents/users/$(child)/guardian/link));
      }
      match /guardian/{doc} {
        allow read: if self(uid) || guardian(uid);
        allow create: if doc == 'link' && signedIn() && !self(uid) &&
          request.resource.data.keys().hasOnly(['parentUid','parentName','linkedAt','pairCode']) &&
          request.resource.data.parentUid == request.auth.uid &&
          request.resource.data.parentName is string && request.resource.data.parentName.size() <= 60 &&
          request.resource.data.linkedAt is int && request.resource.data.pairCode is string &&
          pairValid(request.resource.data.pairCode, uid) &&
          getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/children/$(uid)).data.linkedAt == request.resource.data.linkedAt;
        allow update: if doc == 'link' && guardian(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codeSalt','codeHash']) &&
          ((!('codeSalt' in request.resource.data) && !('codeHash' in request.resource.data)) ||
            (request.resource.data.codeSalt is string && request.resource.data.codeSalt.size() <= 128 &&
             request.resource.data.codeHash is string && request.resource.data.codeHash.size() == 64));
        allow delete: if doc == 'link' && (self(uid) || guardian(uid)) &&
          !existsAfter(/databases/$(database)/documents/users/$(resource.data.parentUid)/children/$(uid)) &&
          !existsAfter(/databases/$(database)/documents/users/$(uid)/remoteRules/current);
      }
      match /progress/{doc} {
        allow read: if self(uid) || guardian(uid);
        allow write: if self(uid);
      }
      match /remoteRules/{doc} {
        allow read: if self(uid) || guardian(uid);
        allow create, update: if guardian(uid);
        allow delete: if guardian(uid) || (self(uid) &&
          !existsAfter(/databases/$(database)/documents/users/$(uid)/guardian/link));
      }
      match /catalog/{doc} {
        allow read: if self(uid) || guardian(uid);
        allow write: if self(uid);
      }
    }
    function guardianRecordMatches(parent, child) {
      return get(/databases/$(database)/documents/users/$(child)/guardian/link).data.parentUid == parent;
    }
    // The weekly board. A row is a name and an hour count — nothing else —
    // and it is readable by anyone signed in, because being on a board is a
    // public act. Writing is not: a row is only ever yours.
    match /leaderboard/{week}/entries/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) &&
        request.resource.data.keys().hasOnly(['name', 'minutes', 'updatedAt']) &&
        request.resource.data.minutes is int &&
        request.resource.data.minutes >= 0 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 60;
      allow delete: if isSelf(uid);
    }
  }
}
