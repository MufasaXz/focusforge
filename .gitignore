# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Android signing material — never commit the keystore or its passwords.
/android/key.properties
/android/*.jks
/android/*.keystore

# Firebase client configuration is supplied locally. It is extractable from an
# APK and is not a database password; keep real project identifiers out of git.
/android/app/google-services.json
**/.env
**/.env.*
!**/.env.example
**/*service-account*.json
**/*adminsdk*.json
*.pem
*.p12
/output/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local Firebase rules test dependencies and emulator state.
/tool/firebase/node_modules/
/.firebase/

/functions/node_modules/

# Vendored build plugins and path packages keep generated output local.
/third_party/**/.gradle/
/third_party/**/.kotlin/
/third_party/**/build/
